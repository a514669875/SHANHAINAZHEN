{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[Backend] FastAPI :8000",
      "type": "shell",
      "command": "${workspaceFolder}/backend/venv/Scripts/python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {}
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "shanhai-backend"
      },
      "problemMatcher": [],
      "detail": "山海纳珍录 · 后端 API（需已创建 backend/venv 并安装依赖）"
    },
    {
      "label": "[Frontend] Vite :5173",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {}
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "shanhai-frontend"
      },
      "problemMatcher": [],
      "detail": "山海纳珍录 · 前端开发服务器"
    },
    {
      "label": "[Full] 同时启动前后端",
      "dependsOn": ["[Backend] FastAPI :8000", "[Frontend] Vite :5173"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "detail": "并行打开两个终端面板，分别跑后端与前端"
    },
    {
      "label": "[Package] build_release (前端打包 + 同步 web/dist)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build_release.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "detail": "npm build:pack 并 robocopy 到 backend/web/dist（需本机 Node）"
    },
    {
      "label": "[Desktop] 本机服务 :18080 (API+网页)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/start.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "group": "shanhai-desktop"
      },
      "problemMatcher": [],
      "detail": "封装版启动：start.bat 默认 18080（SHANHAI_PORT 可改），需 backend/venv"
    }
  ]
}
