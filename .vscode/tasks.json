{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[Backend] FastAPI :8000",
      "type": "shell",
      "command": "${workspaceFolder}/backend/venv/Scripts/python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {}
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "shanhai-backend"
      },
      "problemMatcher": [],
      "detail": "山海纳珍录 · 后端 API（需已创建 backend/venv 并安装依赖）"
    },
    {
      "label": "[Frontend] Vite :5173",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {}
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "shanhai-frontend"
      },
      "problemMatcher": [],
      "detail": "山海纳珍录 · 前端开发服务器"
    },
    {
      "label": "[Full] 同时启动前后端",
      "dependsOn": ["[Backend] FastAPI :8000", "[Frontend] Vite :5173"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "detail": "并行打开两个终端面板，分别跑后端与前端"
    }
  ]
}
